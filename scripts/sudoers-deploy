# Sudoers configuration for deploy user — OKAMI Branding
# Copy this file to /etc/sudoers.d/deploy-okami on the VPS
#
# Usage (as root):
#   cp sudoers-deploy /etc/sudoers.d/deploy-okami
#   chmod 440 /etc/sudoers.d/deploy-okami
#   visudo -cf /etc/sudoers.d/deploy-okami   # validate syntax
#
# This gives the deploy user passwordless sudo for automated deployments.
deploy ALL=(ALL) NOPASSWD: ALL

